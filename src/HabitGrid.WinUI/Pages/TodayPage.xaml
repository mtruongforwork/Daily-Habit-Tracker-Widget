<Page
    x:Class="HabitGrid.WinUI.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HabitGrid.WinUI"
    xmlns:controls="using:HabitGrid.WinUI.Controls"
    xmlns:vm="using:HabitGrid.Presentation.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- Lưới thẻ tự co giãn 1–5 cột theo bề rộng -->
        <UniformGridLayout x:Key="CardLayout" MinItemWidth="228" MinItemHeight="176"
                           MinRowSpacing="14" MinColumnSpacing="14" ItemsStretch="Fill" />

        <DataTemplate x:Key="CardTemplate" x:DataType="vm:HabitTodayItem">
            <controls:HabitCard Item="{x:Bind}" />
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" x:DataType="vm:TodayGroup">
            <StackPanel>
                <TextBlock Text="{x:Bind local:Ui.GroupTitle(TimeOfDay)}" Style="{StaticResource SectionHeader}" />
                <ItemsRepeater ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource CardTemplate}"
                               Layout="{StaticResource CardLayout}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="30,8,34,40" Spacing="0">

                <!-- Đầu trang -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,4,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="GreetingText" Style="{StaticResource DisplayTextStyle}" />
                        <TextBlock x:Name="DateText" Style="{StaticResource BodySecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="BackToTodayButton" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"
                                Click="OnBackToToday" />
                        <Button x:Name="AddButton" Style="{StaticResource GradientButtonStyle}" Click="OnAddClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Name="AddButtonText" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Đang tạm nghỉ -->
                <InfoBar x:Name="VacationBar" Severity="Success" IsOpen="False" IsClosable="False" Margin="0,12,0,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="VacationEndButton" Click="OnVacationEndClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Dải tuần -->
                <controls:WeekStrip x:Name="Strip" Margin="0,18,0,14" />

                <!-- Cảm xúc trong ngày -->
                <controls:MoodBar x:Name="Mood" Margin="0,0,0,14" />

                <!-- Routine -->
                <controls:WeeklyCardStrip x:Name="Weekly" Margin="0,0,0,14" />
                <controls:RoutineStrip x:Name="Routines" Margin="0,0,0,14" />
                <controls:ChallengeStrip x:Name="Challenges" Margin="0,0,0,14" />

                <!-- Bento: hero + streak -->
                <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
                    <controls:HeroTile x:Name="Hero" />
                    <controls:StreakTile x:Name="StreakBox" Grid.Column="1" />
                </Grid>

                <!-- Thẻ thói quen theo khung giờ -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" ItemTemplate="{StaticResource GroupTemplate}" />

                <!-- Không cần hôm nay -->
                <StackPanel x:Name="NotTodayPanel" Visibility="Collapsed">
                    <ToggleButton x:Name="NotTodayToggle" Style="{StaticResource ChipStyle}" HorizontalAlignment="Left"
                                  Margin="0,24,0,12" Click="OnNotTodayToggle" />
                    <ItemsRepeater x:Name="NotTodayRepeater" ItemsSource="{x:Bind ViewModel.NotToday}"
                                   ItemTemplate="{StaticResource CardTemplate}" Layout="{StaticResource CardLayout}"
                                   Visibility="Collapsed" Opacity="0.55" />
                </StackPanel>

                <!-- Trạng thái trống -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                            Margin="0,48,0,0" Spacing="10" MaxWidth="440">
                    <TextBlock Text="🐣" FontSize="72" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource TitleDisplayTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" TextWrapping="Wrap" TextAlignment="Center"
                               Style="{StaticResource BodySecondaryTextStyle}" />
                    <Button x:Name="EmptyAddButton" Style="{StaticResource GradientButtonStyle}" Click="OnAddClick"
                            HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Hoàn tác + lỗi nổi ở đáy -->
        <StackPanel VerticalAlignment="Bottom" Margin="30,0,34,16" Spacing="8">
            <InfoBar x:Name="UndoBar" Severity="Success" IsClosable="True" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button x:Name="UndoButton" Click="OnUndoClick" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ErrorBar" Severity="Warning" IsClosable="True" IsOpen="False" />
        </StackPanel>

        <controls:ConfettiOverlay x:Name="Confetti" />
    </Grid>
</Page>
